# Scientific Calculator API Configuration

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# API Configuration
API_VERSION=1.0.0
API_PREFIX=/api

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# History
HISTORY_MAX_ENTRIES=1000
HISTORY_STORAGE=memory
